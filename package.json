{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@sanity/client": "^8.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "3.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.0",
    "miniflare": "4.20260730.0",
    "npm-check-updates": "^23.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "undici@7": "7.30.1",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.0"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config=playwright.full.config.js",
    "check:page-builder": "node scripts/check-page-builder-requirements.mjs",
    "check:page-builder:build": "node scripts/check-page-builder-build.mjs",
    "test:css-studio:server": "node --test server/css-studio/runtime/quota.runtime.mjs",
    "test:css-studio:server:browser": "node --test server/css-studio/runtime/http.browser.mjs server/css-studio/runtime/proxy-fetch.browser.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
